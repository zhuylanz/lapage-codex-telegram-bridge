{
  "name": "@lapage/codex-telegram-bridge",
  "version": "1.0.8",
  "description": "LaPage Digital's open-source Telegram bridge for securely controlling a local Codex CLI session.",
  "type": "module",
  "bin": {
    "codex-telegram-bridge": "dist/index.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuylanz/lapage-codex-telegram-bridge.git"
  },
  "homepage": "https://github.com/zhuylanz/lapage-codex-telegram-bridge#readme",
  "bugs": {
    "url": "https://github.com/zhuylanz/lapage-codex-telegram-bridge/issues"
  },
  "author": "LaPage Digital",
  "contributors": [
    "Huy Lan"
  ],
  "keywords": [
    "codex",
    "codex-cli",
    "telegram",
    "telegram-bot",
    "app-server",
    "remote-control",
    "agent",
    "lapage",
    "lapage-digital"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test:file-delivery": "npm run build && node scripts/assert-file-delivery.mjs",
    "test:overrides": "npm run build && node scripts/assert-rpc-overrides.mjs",
    "test": "npm run test:file-delivery && npm run test:overrides",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.44.0",
    "strip-ansi": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
